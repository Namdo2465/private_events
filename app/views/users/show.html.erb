<h1><%= @user.email %>'s Created Events</h1>

<% if @created_events.any? %>
  <% @created_events.each do |event| %>
    <div>
      <h2><%= event.name %></h2>
      <p><%= event.location %></p>
      <p><%= event.date %></p>
    </div>
  <% end %>
<% else %>
  <p>This user has not created any events yet.</p>
<% end %>